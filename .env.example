# Required: secret the scanner extension sends. Make it long and random.
INGEST_KEY=

# Optional: password for the dashboard (leave empty = no password)
DASHBOARD_PASSWORD=

# Optional: minimum MMR spread for the Deals tab (default 1000)
MIN_PROFIT=1000

# Set automatically when you add Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email alerts through Gmail (use a Google App Password, not your normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who gets the alerts (comma-separated). Defaults to GMAIL_USER.
ALERT_EMAIL_TO=
# Set to false to stop emails about cars without a VIN
EMAIL_NO_VIN=true

# Or send through resend.com instead of Gmail
RESEND_API_KEY=
ALERT_EMAIL_FROM=
